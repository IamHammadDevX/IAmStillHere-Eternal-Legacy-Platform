# Application
APP_ENV=local
APP_URL=http://localhost/IAmStillHere
APP_DEBUG=true
SESSION_SECRET=

# Database
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eternal_legacy
DB_USER=root
DB_PASSWORD=

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=IamAlwaysHere
MAIL_ENCRYPTION=tls

# Optional media tooling
# Leave empty to auto-detect ffmpeg from PATH or known local install paths.
FFMPEG_PATH=

# Secure Vault
# Use paths outside public web root / repository. Leave empty for auto local path outside htdocs.
VAULT_STORAGE_PATH=
VAULT_KEY_PATH=

# OpenAI server-side configuration
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-mini

# Gift / Phoolwala redirect
PHOOLWALA_URL=https://www.phoolwala.com
